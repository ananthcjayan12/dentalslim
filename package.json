{
  "name": "dentalsim-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist --d1 DB=dentalsim-db --r2 IMAGES=dentalsim-images",
    "db:migrate:local": "wrangler d1 execute dentalsim-db --local --file=./server/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute dentalsim-db --remote --file=./server/db/schema.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "clsx": "^2.1.1",
    "hono": "^4.6.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260410.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.12.0"
  }
}
